# ===== AI 后端环境变量示例 =====
# 复制为 .env 后填入真实值。所有 Key 缺失时，对应功能返回 501（前端自动降级为离线内容）。

# --- 大模型（出题 / 讲解 / 故事文本，OpenAI 兼容接口）---
# 支持 OpenAI / DeepSeek / Moonshot / 通义千问 / 本地 Ollama 等任意 OpenAI 兼容端点
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-xxxxxxxx
LLM_MODEL=gpt-4o-mini
# 可选：出题/讲解语言与学段约束（会在 prompt 中注入）
LLM_LOCALE=zh-CN

# --- 语音合成 TTS（DashScope CosyVoice / Sambert）---
# 文档: https://help.aliyun.com/zh/model-studio/text-to-speech
DASHSCOPE_API_KEY=
# 可选：发音人，cosyvoice-v1 默认 longxiaochun；sambert 默认 zhichu
TTS_VOICE=longxiaochun
TTS_MODEL=cosyvoice-v1

# --- 故事配图（Google Gemini）---
GEMINI_API_KEY=

# --- 服务配置 ---
# 监听地址与端口（桌面端 Tauri 通常固定 8787）
HOST=0.0.0.0
PORT=8787
# 静态产物目录（Next.js 导出目录 out/），Docker / 桌面构建时由启动脚本注入
STATIC_DIR=../web/out
# 允许跨域的前端来源（移动端自托管时填你的域名；* 仅限内网/测试）
CORS_ORIGIN=*
