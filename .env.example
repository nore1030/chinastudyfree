# ===== 在线 AI 后端环境变量（用于 apps/server 与 Docker）=====
# 复制为 .env 并填入。所有 Key 缺失时，对应能力自动降级为离线预生成内容。

LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

DASHSCOPE_API_KEY=
TTS_VOICE=longxiaochun
TTS_MODEL=cosyvoice-v1

GEMINI_API_KEY=

# 服务端口（桌面/移动端对接此端口）
PORT=8787
CORS_ORIGIN=*

# 移动端(Capacitor) 构建时注入的前端 AI 基地址（留空=同源）。
# 例：NEXT_PUBLIC_AI_BASE=https://study.example.com
NEXT_PUBLIC_AI_BASE=
